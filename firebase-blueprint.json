{
  "entities": {
    "submission": {
      "title": "Job Submission",
      "description": "Submitted candidate questionnaire",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "nameAgeCity": { "type": "string" },
        "targetVacancy": { "type": "string" },
        "experience": { "type": "string" },
        "previousRoles": { "type": "string" },
        "collaborations": { "type": "string" },
        "tasks": { "type": "string" },
        "portfolio": { "type": "string" },
        "contact": { "type": "string" },
        "activeJobTitleRu": { "type": "string" }
      },
      "required": ["id", "createdAt", "nameAgeCity", "contact", "targetVacancy"]
    },
    "partner": {
      "title": "Partner",
      "description": "Affiliated partner of the music label",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "name": { "type": "string" },
        "descriptionRu": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoUrl": { "type": "string" },
        "websiteUrl": { "type": "string" }
      },
      "required": ["id", "createdAt", "name", "descriptionRu", "descriptionEn"]
    },
    "artist": {
      "title": "Artist",
      "description": "Artist of the music label",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "socialUrl": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "createdAt", "name", "imageUrl"]
    },
    "pricing_config": {
      "title": "Pricing Config",
      "description": "Customizable pricing and discounts configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "monthlyDiscount": { "type": "number" },
        "yearlyDiscount": { "type": "number" },
        "prices": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "prices"]
    },
    "extra_service": {
      "title": "Extra Service",
      "description": "Additional optional custom services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleRu": { "type": "string" },
        "titleEn": { "type": "string" },
        "descRu": { "type": "string" },
        "descEn": { "type": "string" },
        "badgeRu": { "type": "string" },
        "badgeEn": { "type": "string" },
        "priceRub": { "type": "number" },
        "priceKzt": { "type": "number" },
        "priceUsd": { "type": "number" },
        "priceEur": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "titleRu", "titleEn", "priceRub"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "submission",
      "description": "Collection of job applicant forms"
    },
    "/partners/{partnerId}": {
      "schema": "partner",
      "description": "Collection of music label partners"
    },
    "/artists/{artistId}": {
      "schema": "artist",
      "description": "Collection of music label artists"
    },
    "/pricing_configs/{configId}": {
      "schema": "pricing_config",
      "description": "Collection of pricing custom configs"
    },
    "/extra_services/{serviceId}": {
      "schema": "extra_service",
      "description": "Collection of extra services"
    }
  }
}
