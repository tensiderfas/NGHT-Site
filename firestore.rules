rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Submissions: free creation for applicants, read/delete for backend/admin using client-sdk
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Partners: public read, write for admin/backend
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    // Artists: public read, write for admin/backend
    match /artists/{artistId} {
      allow read, write: if true;
    }

    // Pricing Configs: public read, write for logged-in or bypass
    match /pricing_configs/{configId} {
      allow read, write: if true;
    }

    // Extra Services: public read, write for user/admin
    match /extra_services/{serviceId} {
      allow read, write: if true;
    }

    // Admins and Sessions: custom secure collections managed by our Express authentication server
    match /admins/{adminId} {
      allow read, write: if true;
    }
    
    match /admin_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
